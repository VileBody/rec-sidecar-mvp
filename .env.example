INWORLD_API_KEY=your-base64-inworld-api-key

# Optional:
# Clean Start browser STT provider. auto prefers native Soniox v5 when SONIOX_API_KEY is set,
# otherwise falls back to the Inworld STT proxy.
# CLEAN_START_STT_PROVIDER=auto
# Set false to debug pure browser/System Audio STT without seller/stage/help LLM workers.
# CLEAN_START_COACH_ENABLED=false
# SONIOX_API_KEY=your-soniox-api-key
# SONIOX_STT_MODEL=stt-rt-v5
# SONIOX_AUDIO_FORMAT=s16le
# SONIOX_LANGUAGE=ru
# SONIOX_SPEAKER_DIARIZATION=true
# Stage detection partials are coalesced so one spoken phrase does not spawn
# dozens of LLM calls. Lower interval is more reactive; higher is cheaper.
# CLEAN_START_STAGE_PARTIAL_INTERVAL_MS=2200
# CLEAN_START_MIN_STAGE_GROWTH=24
# Optional S3-compatible upload for captured browser/system-audio WAV files.
# CLEAN_START_AUDIO_S3_ENDPOINT=https://s3.twcstorage.ru
# CLEAN_START_AUDIO_S3_REGION=ru-1
# CLEAN_START_AUDIO_S3_BUCKET=rec-call-audio
# CLEAN_START_AUDIO_S3_ACCESS_KEY=your-access-key
# CLEAN_START_AUDIO_S3_SECRET_KEY=your-secret-key
# CLEAN_START_AUDIO_S3_PREFIX=rec-audio
# CLEAN_START_AUDIO_S3_PATH_STYLE=true
# ASR_PROVIDER=auto
# Set ASR_PROVIDER=gemini-live to stream mic audio to the FastAPI sidecar, which then
# uses Vertex Gemini Live native-audio ASR. auto keeps Inworld when INWORLD_API_KEY is set.
# REC_SIDECAR_ASR_PROVIDER=gemini-live
# GEMINI_LIVE_ASR_SERVICE_URL=http://127.0.0.1:8088
# GEMINI_LIVE_ASR_WS_URL=ws://127.0.0.1:8088/v1/asr/gemini-live
# GEMINI_LIVE_ASR_TOKEN=
# GEMINI_LIVE_ASR_MODEL=gemini-live-2.5-flash-native-audio
# GEMINI_LIVE_ASR_SAMPLE_RATE=16000
# GEMINI_LIVE_ASR_CHUNK_MS=40
# GEMINI_LIVE_ASR_FORCE_END_TURN_MS=1500
# GEMINI_LIVE_ASR_AUDIO_QUEUE_CHUNKS=400
# GEMINI_LIVE_ASR_AUDIO_MAX_BATCH_MS=40
# GEMINI_LIVE_ASR_AUDIO_FLUSH_LATENCY_MS=2000
# GEMINI_LIVE_ASR_SHOW_PARTIALS=true
# INWORLD_STT_MODEL=soniox/stt-rt-v4
# Inworld currently rejects soniox/stt-rt-v5; keep v4 unless /stt supported models changes.
# INWORLD_STT_SPEAKER_DIARIZATION=true
# INWORLD_STT_LANGUAGE_DETECTION=true
# INWORLD_STT_LANGUAGE=ru
# UI language presets use ru and en.
# INWORLD_STT_SAMPLE_RATE=16000
# INWORLD_STT_CHUNK_MS=100
# INWORLD_MIC_DEVICE=0
# macOS only: mix remote participant / browser / meeting audio into the ASR stream
# through a Core Audio process tap. The app will ask for system audio capture permission.
# REC_SIDECAR_SYSTEM_AUDIO=true
# INWORLD_SHOW_PARTIALS=true
# Semantic STT end_turn flush; not network batching.
# INWORLD_FORCE_END_TURN_MS=4000
# INWORLD_AUDIO_QUEUE_CHUNKS=200
# Transport/backlog controls for audio batching.
# INWORLD_AUDIO_MAX_BATCH_MS=800
# INWORLD_AUDIO_FLUSH_LATENCY_MS=10000
# INWORLD_PARTIAL_UI_INTERVAL_MS=120
# Reconnect controls for transient Inworld/network failures.
# INWORLD_STT_MAX_RECONNECTS=3
# INWORLD_STT_RECONNECT_BACKOFF_MS=750
# INWORLD_STT_RECONNECT_MAX_BACKOFF_MS=5000
# INWORLD_STT_CONNECT_TIMEOUT_MS=10000
# REC_SIDECAR_LOG=logs/rec-sidecar.log
# REC_SIDECAR_RAW_LOG=logs/rec-sidecar.raw.log
# REC_SIDECAR_COACH_LOG=logs/rec-sidecar.coach.log
# REC_SIDECAR_LOG_RAW=false

# Rust app -> FastAPI LLM sidecar:
# COACH_LLM_SERVICE_URL=http://127.0.0.1:8088
# Optional shared bearer token. If set, configure the same value for the service.
# COACH_LLM_SERVICE_TOKEN=
# COACH_LLM_SERVICE_TIMEOUT_SECS=30
# COACH_INTERVAL_MS=2000
# COACH_STAGE_DETECT_INTERVAL_MS=5000
# COACH_RATE_LIMIT_BACKOFF_MS=15000
# Experimental: keep Inworld as visible ASR, but send a second mic stream to
# Gemini Live native-audio for stage/scorecard via function calls.
# COACH_STAGE_AUDIO_LIVE=false
# COACH_STAGE_REST_FALLBACK=false
# COACH_STAGE_AUDIO_LIVE_WS_URL=ws://127.0.0.1:8088/v1/coach/stage/live-audio
# COACH_STAGE_AUDIO_LIVE_CHUNK_MS=40
# COACH_STAGE_AUDIO_LIVE_FORCE_END_TURN_MS=3000

# FastAPI LLM sidecar provider. auto uses Cerebras first if configured, then Vertex as fallback.
# COACH_PROVIDER=auto
# Negotiation intelligence transport for /v1/coach/stage:
# rest = current REST stage + scorecard flow, live = persistent Vertex Gemini Live WebSocket per run_id.
# COACH_INTELLIGENCE_TRANSPORT=rest

# Cerebras live sales coach. These are read by the FastAPI llm-service container.
# CEREBRAS_API_KEY=your-cerebras-api-key
# CEREBRAS_MODEL=zai-glm-4.7
# Frequent REST stage detect model. Defaults to ZAI and returns 204 when stage did not change.
# CEREBRAS_STAGE_MODEL=zai-glm-4.7
# CEREBRAS_HELP_OPENER_PRIMARY_MODEL=zai-glm-4.7
# CEREBRAS_HELP_OPENER_SECONDARY_MODEL=gpt-oss-120b
# CEREBRAS_API_BASE=https://api.cerebras.ai/v1
# CEREBRAS_TIMEOUT_SECS=30
# CEREBRAS_RATE_LIMIT_BACKOFF_MS=15000
# Manual Help flow: after clicking Help, ask ASR to flush, then freeze context after this delay.
# COACH_HELP_CONTEXT_DELAY_MS=300
# COACH_HELP_OPENER_TIMEOUT_MS=4000
# COACH_HELP_CONSTRUCTIVE_TIMEOUT_MS=20000
# Compact context limits for the Help button. Fresh tail is kept when truncating.
# COACH_CONTEXT_MAX_TRANSCRIPT_CHARS=16000
# COACH_CONTEXT_MAX_CHAT_CHARS=4000
# COACH_CONTEXT_MAX_LIVE_PARTIAL_CHARS=1200
# COACH_CONTEXT_MAX_COACH_MESSAGES=6
# CEREBRAS_REASONING_EFFORT=none
# Prompt cache key is an optimization only; requests retry without it if a provider rejects it.
# CEREBRAS_PROMPT_CACHE_KEY=true
# CEREBRAS_PROXY=socks5h://user:password@host:port

# Vertex Gemini live sales coach fallback. Read by the FastAPI llm-service container.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# VERTEX_GEMINI_MODEL=gemini-3.5-flash
# VERTEX_STAGE_MODEL=gemini-3.5-flash
# Scorecard model runs only after a stage change in the REST lane.
# VERTEX_SCORECARD_MODEL=gemini-3.5-flash
# VERTEX_SCORECARD_THINKING_LEVEL=minimal
# Text-to-text Live model for JSON intelligence. Native-audio Live models are better for audio output.
# VERTEX_LIVE_MODEL=gemini-2.0-flash-live-preview-04-09
# VERTEX_LIVE_TIMEOUT_SECS=20
# Native-audio Live model used by the experimental Gemini ASR sidecar endpoint.
# Vertex native-audio Live is regional; global is not supported.
# VERTEX_LIVE_ASR_MODEL=gemini-live-2.5-flash-native-audio
# VERTEX_LIVE_ASR_LOCATION=us-central1
# VERTEX_LIVE_ASR_TIMEOUT_SECS=20
# Native-audio Live model used by the stage/scorecard audio lane.
# VERTEX_LIVE_STAGE_MODEL=gemini-live-2.5-flash-native-audio
# VERTEX_LIVE_STAGE_LOCATION=us-central1
# VERTEX_LIVE_STAGE_TIMEOUT_SECS=20
# VERTEX_THINKING_LEVEL=low
# VERTEX_ADC_CREDENTIALS=~/.config/gcloud/application_default_credentials.json
# Optional short-lived manual bearer token. ADC is better because this expires quickly.
# VERTEX_ACCESS_TOKEN=
# Optional override:
# VERTEX_API_BASE=https://aiplatform.googleapis.com
# GOOGLE_CLOUD_QUOTA_PROJECT=your-billing-or-quota-project

# OpenRouter Gemini text backend. When OPENROUTER_API_KEY is set, FastAPI uses
# OpenRouter for REST text Gemini calls and keeps Vertex only for native Live Audio.
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_PROXY=socks5://user:password@proxy.example:1080
# OPENROUTER_GEMINI_MODEL=google/gemini-3.5-flash
# OPENROUTER_APP_NAME=rec-sidecar
# OPENROUTER_SITE_URL=https://rec.teamgenius.ru

# Optional TTS voices for local roleplay tools.
# INWORLD_TTS_SELLER_VOICE=Elena
# INWORLD_TTS_CLIENT_VOICE=Arkady

INWORLD_ENABLE_SPEAKER_DIARIZATION=true
