{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REC Personal",
  "version": "0.1.0",
  "identifier": "ru.teamgenius.rec-personal",
  "build": {
    "beforeDevCommand": "./scripts/prepare-personal-ui.sh",
    "beforeBuildCommand": "./scripts/prepare-personal-ui.sh",
    "frontendDist": "../personal-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "REC Personal",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Live personal system and microphone transcription",
    "macOS": {
      "minimumSystemVersion": "14.2",
      "infoPlist": "Info.personal.plist"
    }
  }
}
